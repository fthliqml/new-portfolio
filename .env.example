# Prisma runtime connection (Supabase transaction pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"

# Prisma migration connection (Supabase direct or session pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Supabase Auth and Storage
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"

# Single-owner admin access
ADMIN_EMAIL="owner@example.com"
ADMIN_USER_ID="00000000-0000-0000-0000-000000000000"
CMS_MUTATIONS_ENABLED="false"

# Vercel daily maintenance endpoint
CRON_SECRET="replace-with-at-least-32-random-characters"
